# ========================================================
# Campus Market Hub - Environment Configuration Template
# Copy this file to .env and adjust your local credentials.
# ========================================================

APP_NAME="Campus Market Hub"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_market_hub
DB_USER=root
DB_PASS=

# Cloudinary Storage (Optional - Defaults to local storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=campus_market_hub

# Socket.io Real-Time Chat Server (Optional)
SOCKET_SERVER_URL=http://localhost:3000

# M-Pesa Integration Stub (v1 is cash/meetup; ready for v2 payment gateway)
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=http://localhost:8000/api/mpesa/callback
